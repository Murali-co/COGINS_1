# COGNIS Environment Configuration
# Copy this to .env and update with your values

# Database
POSTGRES_DB=cognis_db
POSTGRES_USER=cognis
POSTGRES_PASSWORD=cognis_secure_password
POSTGRES_PORT=5432

# ChromaDB
CHROMA_PORT=8000

# Ollama LLM
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# FastAPI Backend
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
ENVIRONMENT=development
DEBUG=true

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Email Service (Resend)
# Get API key from https://resend.com
RESEND_API_KEY=

# File uploads
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE=104857600

# Job Scraper
JOBSPY_RETRIES=3
SCRAPE_DELAY_SECONDS=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Production Settings (update for production)
# SECURITY_PASSWORD_SALT=your-salt
# SECURITY_ALGORITHM=HS256
# SSL_ENABLED=false
